{
  "cleanUrls": false,
  "routes": [
    {
      "src": "/validation-key.txt",
      "dest": "/validation-key.txt",
      "headers": {
        "content-type": "text/plain; charset=utf-8",
        "cache-control": "s-maxage=0, max-age=0, no-cache, no-store, must-revalidate",
        "access-control-allow-origin": "*"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
